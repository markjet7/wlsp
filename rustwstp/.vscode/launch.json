{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'rustwstp'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=rustwstp",
                    "--package=rustwstp"
                ],
                "filter": {
                    "name": "rustwstp",
                    "kind": "bin"
                },
                "env": {
                    "WSTP_COMPILER_ADDITIONS_DIRECTORY": "/Applications/Wolfram.app/Contents/SystemFiles/Links/WSTP/DeveloperKit/MacOSX-x86-64/CompilerAdditions/",
                    "WOLFRAM_APP_DIRECTORY":"/Applications/Wolfram.app/"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'rustwstp'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=rustwstp",
                    "--package=rustwstp"
                ],
                "filter": {
                    "name": "rustwstp",
                    "kind": "bin"
                },
                "env": {
                    "WSTP_COMPILER_ADDITIONS_DIRECTORY": "/Applications/Wolfram.app/Contents/SystemFiles/Links/WSTP/DeveloperKit/MacOSX-x86-64/CompilerAdditions",
                    "WOLFRAM_APP_DIRECTORY":"/Applications/Wolfram.app"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug integration test 'scratch'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--test=scratch",
                    "--package=rustwstp"
                ],
                "filter": {
                    "name": "scratch",
                    "kind": "test"
                },
                "env": {
                    "WSTP_COMPILER_ADDITIONS_DIRECTORY": "/Applications/Wolfram.app/Contents/SystemFiles/Links/WSTP/DeveloperKit/MacOSX-x86-64/CompilerAdditions",
                    "WOLFRAM_APP_DIRECTORY":"/Applications/Wolfram.app"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
        }
    ]
}